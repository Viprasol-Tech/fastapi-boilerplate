# FastAPI Boilerplate — example environment configuration.
# Copy to ".env" and adjust. All variables are prefixed with APP_.

APP_APP_NAME="FastAPI Boilerplate"
APP_ENVIRONMENT=development
APP_DEBUG=false

# Versioned API mount point.
APP_API_V1_PREFIX=/api/v1

# Comma-separated list of accepted API keys (sent via the X-API-Key header).
APP_API_KEYS=dev-secret-key

# Comma-separated CORS origins ("*" allows all).
APP_CORS_ORIGINS=*

# Pagination defaults.
APP_DEFAULT_PAGE_SIZE=20
APP_MAX_PAGE_SIZE=100
